rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================
    // All Firestore access now goes through the server-side Admin
    // SDK (src/lib/firebase.js), which bypasses security rules.
    // The browser client no longer talks to Firebase at all, so
    // there are no authenticated end-user requests to allow.
    //
    // These rules deny ALL client (Web SDK) access by default.
    // If a client SDK is ever re-enabled, write explicit per-
    // collection rules before allowing anything through.
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
