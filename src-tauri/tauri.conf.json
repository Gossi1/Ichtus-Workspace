{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ichtus Workspace",
  "version": "3.0.3",
  "identifier": "nl.ichtus.workspace",
  "build": {
    "frontendDist": "loading"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' tauri: http: https: ws:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: http: https:; font-src 'self' data:; connect-src 'self' http: https: ws: tauri:;"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../Ichtus_SPA/": "app/Ichtus_SPA/",
      "../assets/": "app/assets/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRFMDgyQUQ2MDJEMjEzNTkKUldSWkU5SUMxaW9JVHJEaG5UdGdIV2diSXVpaHNzNWFBRDV4Q3lady83WmVvTFI2S0JJZWFYUkYK",
      "endpoints": [
        "https://github.com/Gossi1/Ichtus-Workspace/releases/latest/download/latest.json"
      ]
    }
  }
}
